# Added 31-Aug-2026 - RSI-70/30-threshold ETH sibling of deploy/
# turion-crypto-options-eth.service - see deploy/turion-crypto-
# options-btc-rsi70.service's own note for the full reasoning (same
# real finding, same backtest-tuned fix, just the ETH leg - ETH's own
# sweep showed the SAME 70/30 threshold working best, extremely
# consistently across two different real windows: +$2,064 and
# +$2,067, near-identical).
#
# Install with:
#   sudo cp deploy/turion-crypto-options-eth-rsi70.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable turion-crypto-options-eth-rsi70
#   sudo systemctl start turion-crypto-options-eth-rsi70
#
# Useful commands once running:
#   sudo systemctl status turion-crypto-options-eth-rsi70
#   journalctl -u turion-crypto-options-eth-rsi70 -f
#   sudo systemctl restart turion-crypto-options-eth-rsi70

[Unit]
Description=TURION Crypto Options Engine (Deribit ETH, RSI 70/30 threshold, WebSocket, paper-trading)
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

WorkingDirectory=/home/ubuntu/turion-crypto
ExecStart=/home/ubuntu/turion-crypto/venv/bin/python run_crypto_options_engine.py

Restart=on-failure
RestartSec=10

Environment="CRYPTO_CURRENCY=ETH"
Environment="CRYPTO_RSI_CE_THRESHOLD=70"
Environment="CRYPTO_RSI_PE_THRESHOLD=30"

EnvironmentFile=/home/ubuntu/turion-crypto/.env

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
