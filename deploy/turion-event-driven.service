# Added 18-Aug-2026 - systemd unit for running run_event_driven_engine.py
# continuously on the (future) VPS, with auto-restart on crash and
# auto-start on boot. Same "code-prep now, live-test later" status as
# the rest of tonight's event-driven work (see run_event_driven_engine.
# py, strategy/event_driven_runner.py, live_tick_harness.py) - this is
# a config file, not Python/Dart, so there is no unit test for it
# either way; it can only be checked for syntax, not actually run,
# until a real Linux/systemd VPS exists.
#
# NOT LIVE-TESTED. The paths and user below are PLACEHOLDERS - fill in
# the real ones once the VPS exists, then install with:
#
#   sudo cp deploy/turion-event-driven.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable turion-event-driven   # auto-start on boot
#   sudo systemctl start turion-event-driven
#
# Useful commands once running:
#   sudo systemctl status turion-event-driven   # is it up, last exit code
#   journalctl -u turion-event-driven -f        # follow live logs
#   sudo systemctl restart turion-event-driven  # manual restart
#
# Every day's access_token still arrives via Firebase Realtime Database
# (see run_event_driven_engine.py) - this service does not need to be
# restarted for a new token; it re-fetches at its own startup only, so
# a fresh login each morning is a separate concern from this service
# staying up.
#
# DECIDED 18-Aug-2026 - the real gap this raised, found while
# reviewing VPS readiness: deploy.sh's daily cron restarts this
# service at 08:00 IST, but if the user hasn't tapped "Login to Fyers"
# in the app YET at that moment, run_event_driven_engine.py exits
# CLEANLY (exit 0 - no token available today) - and a clean exit is
# NOT restarted by Restart=on-failure below, by design (see that
# section's own comment). A login at, say, 08:30 or 09:00 (still
# before the 09:15 IST market open) would otherwise leave the engine
# sitting stopped all day, needing a manual restart nobody would think
# to do. FIX (VPS-side cron only, no code change - keeps this exact
# same problem class Tier-2/OnFailure alerting doesn't have to reason
# about, since a clean exit 0 was never a "failure" to begin with):
# add a second cron entry that retries `systemctl start` (NOT restart
# - a no-op if already running, so this is always safe to fire) every
# few minutes across the pre-market window only:
#   30-55/5 2 * * 1-5 sudo systemctl start turion-event-driven
#   */5 3 * * 1-5 sudo systemctl start turion-event-driven
#   0-25/5 4 * * 1-5 sudo systemctl start turion-event-driven
# (every 5 min, 08:00-09:55 IST window as a safety margin past 09:15
# open, Mon-Fri - three lines because cron runs in the VPS's own UTC
# clock, not IST, and 08:00-09:55 IST straddles a UTC hour boundary at
# the :30 mark; see the FIXED 21-Aug-2026 note below). Deliberately
# narrow window, not all-day polling - once the engine is running it
# stays running, this only covers the "hasn't started yet today" gap
# right around market open.
#
# FIXED 21-Aug-2026 - real bug caught live: the single-line example
# originally here, "*/5 8-9 * * 1-5", is only correct if crontab runs
# in IST - it doesn't; the VPS's system clock is UTC (`timedatectl`
# confirmed Etc/UTC). In a UTC crontab, "8-9" means 08:00-09:59 UTC =
# 13:30-15:59 IST - mid-afternoon, well into trading hours, not the
# intended pre-market window at all. Found by re-auditing the live
# installed crontab (`crontab -u turion -l`) against this file's own
# comment and noticing this line used raw IST-looking digits while the
# 4 health-check cron lines nearby were correctly UTC-converted at
# install time. Fixed on the live VPS crontab directly first, then
# here (this comment being correct now only prevents the same mistake
# on a future re-install).
#
# CORRECTED 18-Aug-2026 - the `sudo` above was missing when first
# written (found during a full VPS-file re-check): this cron entry
# runs as the non-root `turion` user (same as deploy.sh's own crontab
# entry), and `systemctl start` on a system-level unit needs root -
# without `sudo` here it would fail with a permission error every
# single time. Matches the NOPASSWD sudoers scope already granted for
# exactly this command (see deploy.sh's own comment) and deploy.sh's
# own internal `sudo systemctl restart` call.
#
# CORRECTED 18-Aug-2026, while adding connection monitoring: the
# EnvironmentFile= line below was WRONGLY marked "nothing needed here"
# when first written - actually wrong, caught while tracing through
# fetch_access_token()/sync_portfolio()/the new connection-alert push:
# all three call into report/firebase_realtime_sync.py or report/
# push_notifier.py, both of which read FIREBASE_SERVICE_ACCOUNT (and
# the runtime path additionally needs FIREBASE_DATABASE_URL) from the
# environment - this service DOES need them, same as the GitHub Actions
# workflows already pass via secrets. Uncommented below.

[Unit]
Description=TURION Event-Driven Options Engine (WebSocket, real-time)
After=network-online.target
Wants=network-online.target

# Fires deploy/turion-engine-alert.service (a separate push-notification-
# only oneshot unit) every time this unit enters the "failed" state -
# i.e. on every real process crash, whether or not it's about to auto-
# restart under Restart=on-failure above. This is DIFFERENT from the
# in-process connection-issue alert in strategy/event_driven_runner.py
# (_should_send_connection_alert) - that one covers the WebSocket
# flapping while the Python process stays alive; this one covers the
# process itself dying. Deliberately NOT rate-limited at this layer
# (unlike the in-process one) - a process crash is expected to be rare,
# so alerting on every occurrence (not just once retries are exhausted)
# is the right default; revisit if it turns out noisy in practice.
# CHANGED 24-Aug-2026 - was OnFailure=turion-engine-alert.service (the
# old single-purpose unit) - now the generic template shared by all 3
# VPS services, see deploy/turion-alert@.service's own note. %N = this
# unit's own name without ".service", so %i inside the alert template
# correctly resolves to "turion-event-driven" (not the alert unit's own
# name, the real bug the old single-target setup had).
OnFailure=turion-alert@%N.service

# Caps restart attempts so a persistently-crashing engine doesn't spin
# forever - 5 attempts within 5 minutes, then systemd gives up and the
# unit needs a manual `systemctl restart` after the underlying issue
# (bad credentials, Fyers API down, etc.) is fixed.
#
# MOVED from [Service] to [Unit] 24-Aug-2026, real bug found live:
# StartLimit* keys only take effect in [Unit] - systemd silently
# ignored them in [Service] the whole time ("Unknown key
# 'StartLimitIntervalSec' in section [Service], ignoring" - confirmed
# via a real journalctl warning on a sibling service). This 5-attempts/
# 300s cap had NEVER actually been enforced - direct evidence: 22-Aug's
# real Saturday crash-loop reached "restart counter is at 139", far
# past what a working StartLimitBurst=5 would ever have allowed.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# PLACEHOLDER - set to wherever this repo is checked out on the VPS.
WorkingDirectory=/opt/turion/TURION_AI_Trader

# PLACEHOLDER - use the VPS's venv, not system python.
ExecStart=/opt/turion/TURION_AI_Trader/venv/bin/python run_event_driven_engine.py

# Crash (bad tick data, WebSocket drop the fyers_apiv3 client doesn't
# recover from, etc.) restarts after a short delay rather than leaving
# the engine down for the rest of the trading day. A clean exit code 0
# (Firebase has no token yet - see run_event_driven_engine.py) is NOT
# a crash and is intentionally NOT restarted by this policy; systemd
# only restarts on failure, so a clean "nothing to do today" exit just
# ends the unit until it's next started (manually, or via the timer/
# cron approach if this ends up needing a daily kick - not decided).
Restart=on-failure
RestartSec=10

# PLACEHOLDER - a non-root service account, not root. Create with
# `sudo useradd -r -s /usr/sbin/nologin turion` once the VPS exists.
User=turion

# PLACEHOLDER - needs FIREBASE_SERVICE_ACCOUNT and FIREBASE_DATABASE_URL
# at minimum (see the CORRECTED note above) - same two values already
# passed as GitHub Actions secrets in .github/workflows/fyers_trigger.
# yml, just delivered here via a VPS-local .env file instead since this
# process isn't a GitHub Actions runner. This file does not exist in
# the repo (secrets are never committed) - create it manually on the
# VPS once it exists.
EnvironmentFile=/opt/turion/TURION_AI_Trader/.env

# Added 18-Aug-2026 - paper vs live execution mode, resolved in run_
# event_driven_engine.py via strategy/execution_backend.py. Defaults
# to "paper" if unset entirely, so leaving this line commented out (as
# it is today) is safe and explicit. "live" isn't built yet and will
# raise a clear error rather than silently doing something unintended
# - see execution_backend.py's module docstring for what "live" still
# needs before it can exist.
# Environment=TURION_EXECUTION_MODE=paper

# Sends stdout/stderr to the systemd journal (journalctl -u ...)
# instead of a separate log file - nothing extra to rotate; journald
# handles rotation on its own.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
