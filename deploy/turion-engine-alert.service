# Added 18-Aug-2026 - the crash-detection half of VPS monitoring,
# alongside the in-process connection-issue alert in strategy/event_
# driven_runner.py (_should_send_connection_alert). Triggered by
# turion-event-driven.service's OnFailure= directive whenever that
# unit enters the "failed" state - i.e. the whole engine process died,
# not just a WebSocket blip the SDK's own reconnect handled on its own.
#
# App push notification ONLY (report/push_notifier.py's
# send_push_notification()), same choice and same reason as the
# in-process alert: the user does not use Telegram, so report/
# notifier.py's notify() (which would also fire a Telegram message) is
# deliberately NOT used here. Reuses the existing "trade_alerts" FCM
# topic the app already subscribes to (mobile_app/lib/main.dart) - no
# new mobile app code needed.
#
# NOT LIVE-TESTED - config file, no VPS to trigger a real OnFailure=
# against yet. Install alongside turion-event-driven.service:
#
#   sudo cp deploy/turion-engine-alert.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# (No `enable`/`start` needed - this unit only ever runs when systemd
# fires it via the other unit's OnFailure=, never on its own.)

[Unit]
Description=TURION Event-Driven Engine crash alert (push notification only)

[Service]
Type=oneshot
WorkingDirectory=/opt/turion/TURION_AI_Trader

# Same secrets file as turion-event-driven.service - needs at least
# FIREBASE_SERVICE_ACCOUNT to authenticate the push notification.
EnvironmentFile=/opt/turion/TURION_AI_Trader/.env

# Deliberately a one-line inline Python call rather than a separate
# .py script - this is the entire job (send one push notification),
# not worth a dedicated file. `%n` is the failed unit's own name,
# passed by systemd - kept in the message so a future turion-alert-
# style unit reused for something else would say what actually failed.
ExecStart=/opt/turion/TURION_AI_Trader/venv/bin/python -c "from report.push_notifier import send_push_notification; send_push_notification('TURION Engine Down', 'The event-driven engine on the VPS crashed (unit: %n). Check: systemctl status turion-event-driven / journalctl -u turion-event-driven -n 50')"
